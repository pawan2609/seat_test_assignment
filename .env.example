# Copy to .env (git-ignored) for docker-compose.prod.yml.
# Generate secrets with: openssl rand -hex 32
TOKEN_SECRET=
ADMIN_TOKEN=
# Public hostname Caddy serves and gets a certificate for, e.g. a sslip.io name
# for the VM's IP (13-127-237-241.sslip.io) or your own subdomain.
DOMAIN=
# Host address Caddy binds 80/443 on. Default 0.0.0.0; set the VM's private IP
# if something else (e.g. Tailscale) already holds :443 on another address.
BIND_IP=
